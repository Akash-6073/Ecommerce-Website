{
    "version": 2,
    "builds": [
      {
        "src": "index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.js"
      }
    ],
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "https://ecartserver.vercel.app/:path*"
      },
      {
        "source": "/api/:path*/",
        "destination": "https://ecartserver.vercel.app/:path*/"
      }
    ]
}  